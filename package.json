{
    "name": "mealbot_insta",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "generate": "tsx src/generate.tsx",
        "once": "npx tsx src/index.ts --once",
        "build": "tsc",
        "start": "node dist/index.js",
        "bstart": "npm run build && npm run start",
        "check": "tsc --noEmit",
        "prettier": "prettier --write ."
    },
    "dependencies": {
        "axios": "^1.13.6",
        "dayjs": "^1.11.20",
        "dotenv": "^17.3.1",
        "instagram-private-api": "^1.46.1",
        "mime-types": "^3.0.2",
        "node-schedule": "^2.1.1",
        "react": "^19.2.4",
        "satori": "^0.25.0",
        "sharp": "^0.34.5",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "@types/node-schedule": "^2.1.8",
        "@types/react": "^19.2.14",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "prettier": {
        "semi": true,
        "singleQuote": true,
        "printWidth": 100,
        "tabWidth": 4
